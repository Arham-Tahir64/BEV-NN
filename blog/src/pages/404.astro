---
import Base from '../layouts/Base.astro';
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<Base title="Page not found — BEV-NN">
  <main id="main" class="wrap" style="padding-top:80px;padding-bottom:100px">
    <p class="eyebrow">404 / Outside the grid</p>
    <h1 style="font-family:var(--serif);font-size:48px;font-weight:450">This field note isn’t here.</h1>
    <p>The link may have changed, or the entry hasn’t been written yet.</p>
    <a class="text-link" href={home}>Return to the development log →</a>
  </main>
</Base>
