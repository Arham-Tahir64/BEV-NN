---
import Base from './Base.astro';
import { formatDate } from '../lib/posts';
interface Props {
  frontmatter: { title: string; description: string; date: string; lastUpdated?: string; number: string; status: string; tags: string[]; };
  headings: { depth: number; slug: string; text: string; }[];
}
const { frontmatter: post, headings = [] } = Astro.props;
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const contents = headings.filter(heading => heading.depth === 2);
---
<Base title={`${post.title} — BEV-NN`} description={post.description} article>
  <main id="main" class="wrap post-page">
    <a class="back-link" href={`${home}#entries`}>← All field notes</a>
    <header class="post-header">
      <p class="eyebrow">Field note {post.number} <span class="eyebrow-separator">/</span> <time datetime={post.date}>{formatDate(post.date)}</time></p>
      <h1>{post.title}</h1>
      <p class="post-deck">{post.description}</p>
      <div class="post-byline"><span>By <strong>Arham Tahir</strong></span><span class="entry-status">{post.status}</span></div>
      {post.lastUpdated && <p class="post-updated">Updated <time datetime={post.lastUpdated}>{formatDate(post.lastUpdated)}</time></p>}
      <div class="tags">{post.tags.map(tag => <span>{tag}</span>)}</div>
    </header>
    <div class="post-grid">
      <aside class="post-sidebar"><nav aria-label="On this page"><p class="small-label">In this field note</p><ol>{contents.map(heading => <li><a href={`#${heading.slug}`}>{heading.text.replace(/^\d+\.\s*/, '')}</a></li>)}</ol></nav><p class="sidebar-note">An open notebook.<br />Ideas first. Evidence next.</p></aside>
      <article class="prose"><slot /><div class="post-end"><span class="eyebrow">End of field note {post.number}</span><p>The next step: validate the baseline, then measure what changes.</p><a class="text-link" href="https://github.com/Arham-Tahir64/BEV-NN">Follow the implementation on GitHub ↗</a></div></article>
    </div>
  </main>
</Base>
