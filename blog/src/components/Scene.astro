---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const cells = Array.from({ length: 9 }, (_, row) =>
  Array.from({ length: 9 }, (_, col) => ({ row, col })),
).flat();
---
<div class:list={['scene', { compact }]}>
  <div class="scene-label"><span class="status-dot"></span> A scene, reconstructed <span class="scene-label-right">CONCEPT / 001</span></div>
  <svg viewBox="0 0 520 320" role="img" aria-label="Conceptual isometric voxel grid showing roads and objects around an ego vehicle. This is an illustration, not model output.">
    <g transform="translate(260 36)">
      {cells.map(({row, col}) => {
        const x = (col - row) * 25;
        const y = (col + row) * 13;
        const road = row >= 3 && row <= 5 || col >= 3 && col <= 5;
        return <path d={`M${x},${y} l25,13 -25,13 -25,-13 Z`} fill={road ? '#d5dccb' : '#edf0de'} stroke="#b9c5ac" stroke-width="0.8" />;
      })}
      {[
        { x: 0, y: 104, h: 24, w: 22, color: '#537361' },
        { x: 100, y: 104, h: 46, w: 22, color: '#a3ad82' },
        { x: -100, y: 104, h: 64, w: 22, color: '#a3ad82' },
        { x: 75, y: 169, h: 39, w: 22, color: '#a3ad82' },
        { x: -75, y: 169, h: 18, w: 22, color: '#bb8155' },
        { x: 0, y: 208, h: 12, w: 16, color: '#bb8155' },
      ].map(({x, y, h, w, color}) => <g>
        <path d={`M${x-w},${y} v${-h} l${w},${-w/2} ${w},${w/2} v${h} l${-w},${w/2} Z`} fill={color} stroke="#f1f2e6" stroke-width="1" />
        <path d={`M${x-w},${y-h} l${w},${w/2} ${w},${-w/2} M${x},${y-h+w/2} v${h}`} fill="none" stroke="#f1f2e6" stroke-width="1" />
      </g>)}
      <path d="M0 126V73M0 126l-48 25M0 126l48 25" stroke="#213e35" stroke-width="1.2" stroke-dasharray="3 4" fill="none" />
    </g>
    <text x="25" y="294" font-size="10" fill="#657264" font-family="monospace">6 CAMERAS → FEATURES → VOXELS</text>
    <text x="495" y="294" text-anchor="end" font-size="10" fill="#657264" font-family="monospace">x / y / z</text>
  </svg>
  <div class="scene-legend"><span><i style="--swatch:#537361"></i>Ego vehicle</span><span><i style="--swatch:#a3ad82"></i>Scene objects</span><span><i style="--swatch:#d5dccb"></i>Road</span></div>
  <p class="scene-caption">Concept illustration · not a model prediction</p>
</div>
